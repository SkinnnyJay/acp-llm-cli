# =============================================================================
# @simpll/acp-llm-cli — sample environment
# Copy to `.env` and/or `.env.local` and set values. All keys are defined in
# `src/constants/env-keys.ts` (ENV_KEY); use those constants in code, not raw strings.
# @simpill/env.utils may load `.env` then `.env.local` (see package docs).
# =============================================================================

# -----------------------------------------------------------------------------
# Debug
# -----------------------------------------------------------------------------
# Truthy values (1, true, yes) enable debug logging.
ACP_LLM_CLI_DEBUG=0

# -----------------------------------------------------------------------------
# Per-provider CLI overrides (optional)
# -----------------------------------------------------------------------------
# Resolution: defaults in code → these env vars → runtime config passed to the factory.
# ARGS are whitespace-separated (split like a shell word list).
ACP_LLM_CLI_CLAUDE_COMMAND=claude-code-acp
ACP_LLM_CLI_CLAUDE_ARGS=

ACP_LLM_CLI_GEMINI_COMMAND=gemini
ACP_LLM_CLI_GEMINI_ARGS=--experimental-acp

ACP_LLM_CLI_CODEX_COMMAND=codex
ACP_LLM_CLI_CODEX_ARGS=--experimental-acp

ACP_LLM_CLI_CURSOR_COMMAND=cursor-agent
ACP_LLM_CLI_CURSOR_ARGS=

# -----------------------------------------------------------------------------
# Provider API keys (set what your CLIs or cloud APIs need)
# -----------------------------------------------------------------------------
# Claude / Anthropic
ANTHROPIC_API_KEY=

# Gemini (either GOOGLE_API_KEY or GEMINI_API_KEY is accepted where documented)
GOOGLE_API_KEY=
GEMINI_API_KEY=

# OpenAI / Codex
OPENAI_API_KEY=

# Cursor
CURSOR_API_KEY=

# xAI (e.g. Grok — also used by scripts/update-models when set)
XAI_API_KEY=

# -----------------------------------------------------------------------------
# Integration tests
# -----------------------------------------------------------------------------
# Set to 1 to run tests that spawn real CLI processes (see test suite).
RUN_INTEGRATION=

# -----------------------------------------------------------------------------
# scripts/update-models.ts (bun run update-models)
# -----------------------------------------------------------------------------
# Uses ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY or GOOGLE_API_KEY, XAI_API_KEY
# when set; otherwise falls back to OpenRouter public model list where applicable.
# Set to 1 to print what would be written without writing `src/constants/models/*.ts`.
ACP_LLM_CLI_MODELS_DRY_RUN=
