# =============================================================================
# @simpill/acp-llm-cli — sample environment
# Copy to `.env` and/or `.env.local` and set values. All keys are defined in
# `src/domain/env.keys.ts` (ENV_KEY); use those constants in code, not raw strings.
# =============================================================================

# -----------------------------------------------------------------------------
# Debug
# -----------------------------------------------------------------------------
# Truthy values (1, true, yes) enable debug logging.
ACP_LLM_CLI_DEBUG=0

# -----------------------------------------------------------------------------
# Per-provider CLI overrides (optional)
# -----------------------------------------------------------------------------
# Resolution: defaults in code → these env vars → runtime config passed to the factory.
# Caveat: the *_COMMAND keys apply only when you resolve config with `resolveBaseConfig` and leave
# `command` out; a `command` you pass yourself always wins. The *_ARGS keys apply only when the
# `args` you pass are empty or omitted.
# ARGS are whitespace-separated (split like a shell word list).
ACP_LLM_CLI_CLAUDE_COMMAND=claude-agent-acp
ACP_LLM_CLI_CLAUDE_ARGS=

ACP_LLM_CLI_ANTIGRAVITY_COMMAND=agy
# ARGS replaces the default args, so keep `acp` in it.
ACP_LLM_CLI_ANTIGRAVITY_ARGS=acp

ACP_LLM_CLI_CODEX_COMMAND=codex-acp
ACP_LLM_CLI_CODEX_ARGS=

ACP_LLM_CLI_CURSOR_COMMAND=cursor-agent
# ARGS replaces the default args, so keep `acp` in it.
ACP_LLM_CLI_CURSOR_ARGS=acp

# -----------------------------------------------------------------------------
# Provider API keys (set what your CLIs or cloud APIs need)
# -----------------------------------------------------------------------------
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
CURSOR_API_KEY=
XAI_API_KEY=

# -----------------------------------------------------------------------------
# Live provider matrix tests
# -----------------------------------------------------------------------------
# Set to 1 to run tests that spawn real CLI processes (see __tests__/live.providers.matrix.test.ts).
ACP_LLM_CLI_LIVE=

# Restrict the live matrix to one provider id (claude-cli, codex-cli, antigravity-cli, cursor-cli).
# A value that matches no provider runs zero cases, so keep it exact.
ACP_LLM_CLI_PROVIDER=

# -----------------------------------------------------------------------------
# scripts/update-models.ts (npm run update-models)
# -----------------------------------------------------------------------------
# Uses ANTHROPIC_API_KEY, OPENAI_API_KEY, GEMINI_API_KEY or GOOGLE_API_KEY, XAI_API_KEY
# when set; otherwise reads the vendor's public documentation page.
# Set to 1 to print what would be written without writing `src/domain/models/*.ts`.
ACP_LLM_CLI_MODELS_DRY_RUN=
# Set to 1 to make the fetched list authoritative and drop ids no source lists (default: additive).
ACP_LLM_CLI_MODELS_PRUNE=
