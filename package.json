{
  "name": "@simpill/acp-llm-cli",
  "version": "0.2.0",
  "description": "Modular, extensible layer to run ACP-compatible LLM CLIs (Claude, Codex, Gemini, Cursor)",
  "license": "ISC",
  "author": "SkinnnyJay",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    }
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "acp",
    "agent-client-protocol",
    "llm",
    "cli",
    "claude",
    "codex",
    "gemini",
    "cursor",
    "anthropic",
    "openai",
    "stdio"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SkinnnyJay/acp-llm-cli.git"
  },
  "bugs": {
    "url": "https://github.com/SkinnnyJay/acp-llm-cli/issues"
  },
  "homepage": "https://github.com/SkinnnyJay/acp-llm-cli#readme",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "biome check src __tests__",
    "format": "biome format src __tests__",
    "check:fix": "biome check --write src __tests__",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "npm run lint && npm run typecheck && npm run build && npm test",
    "prepublishOnly": "npm run verify:coverage",
    "pack:smoke": "node scripts/pack-smoke.mjs",
    "publint": "node scripts/publint-pack.mjs",
    "update-models": "tsx scripts/update-models.ts",
    "verify:coverage": "npm run lint && npm run typecheck && npm run build && npm run test:coverage"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.3.0",
    "@simpill/async.utils": "^1.0.0",
    "@simpill/env.utils": "^1.0.0",
    "@simpill/errors.utils": "^1.0.0",
    "@simpill/logger.utils": "^1.0.0",
    "@simpill/patterns.utils": "^1.0.0",
    "@simpill/protocols.utils": "^1.0.0"
  },
  "sideEffects": false,
  "peerDependencies": {
    "eventemitter3": "^5.0.1",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.11",
    "eventemitter3": "^5.0.1",
    "publint": "^0.3.24",
    "tsup": "^8.3.5",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "zod": "^3.25.0"
  },
  "files": [
    "dist"
  ],
  "overrides": {
    "@simpill/errors.utils": "^1.0.0",
    "@simpill/patterns.utils": "^1.0.0",
    "@simpill/protocols.utils": "^1.0.0"
  }
}
